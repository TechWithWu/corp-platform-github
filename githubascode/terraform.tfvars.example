# ---------------------------------------------------------------------------------------------------------------------
# terraform.tfvars.example (Optional Catalog Override)
# ---------------------------------------------------------------------------------------------------------------------
# By default, Terraform loads /githubascode/repositories.json directly.
# Use this file if you wish to override repository definitions using HCL syntax.
#
# Authentication is zero-boilerplate: github_owner and github_token are automatically
# read from runner environment variables:
#   GITHUB_TOKEN = "${{ secrets.ADMIN_GITHUB_TOKEN || secrets.GITHUB_TOKEN }}"
#   GITHUB_OWNER = "${{ github.repository_owner }}"
# ---------------------------------------------------------------------------------------------------------------------

repositories = {
  # -------------------------------------------------------------------------
  # A. Platform Infrastructure (Single 'main' branch, 'prod' environment)
  # -------------------------------------------------------------------------
  "corp-platform-foundation" = {
    description        = "Enterprise governance: Management Groups, Azure Policy, RBAC baselines, and subscription vending"
    visibility         = "private"
    protected_branches = ["main"]
    required_approvals = 1
    topics             = ["azure", "landing-zone", "management-groups", "policy"]
    prod_approvers = [
      {
        email    = "seniorguy@gmail.com"
        username = "seniorguy"
      }
    ]
    environments = {
      "prod" = {
        azure_client_id       = "a1b2c3d4-e5f6-7890-abcd-ef1234567890" # SPN: spn-platform-foundation
        azure_tenant_id       = "88888888-4444-4444-4444-121212121212"
        azure_subscription_id = "11111111-2222-3333-4444-555555555555"
      }
    }
  }

  "corp-platform-management" = {
    description        = "Centralized Ops: Log Analytics, Sentinel, Azure Monitor, and alert policies"
    visibility         = "private"
    protected_branches = ["main"]
    required_approvals = 1
    topics             = ["azure", "operations", "sentinel", "monitor"]
    prod_approvers = [
      {
        email    = "ops-lead@gmail.com"
        username = "opslead"
      }
    ]
    environments = {
      "prod" = {
        azure_client_id       = "b2c3d4e5-f6a7-8901-bcde-f12345678901" # SPN: spn-platform-management
        azure_tenant_id       = "88888888-4444-4444-4444-121212121212"
        azure_subscription_id = "22222222-3333-4444-5555-666666666666"
      }
    }
  }

  "corp-platform-connectivity" = {
    description        = "Centralized Networking: Hub VNet, Azure Firewall, VPN/ExpressRoute, and global NSG rules"
    visibility         = "private"
    protected_branches = ["main"]
    required_approvals = 1
    topics             = ["azure", "networking", "firewall", "hub-spoke"]
    prod_approvers = [
      {
        email    = "network-lead@gmail.com"
        username = "netlead"
      }
    ]
    environments = {
      "prod" = {
        azure_client_id       = "c3d4e5f6-a7b8-9012-cdef-123456789012" # SPN: spn-platform-connectivity
        azure_tenant_id       = "88888888-4444-4444-4444-121212121212"
        azure_subscription_id = "33333333-4444-5555-6666-777777777777"
      }
    }
  }

  # -------------------------------------------------------------------------
  # B. Application Services (Dual 'main' & 'dev' branches, 4-tier environments)
  # -------------------------------------------------------------------------
  "corp-billing-api" = {
    description        = "Billing Microservice API: invoice generation, payment gateways, and usage metering"
    visibility         = "private"
    protected_branches = ["main", "dev"] # Direct commits strictly blocked!
    required_approvals = 1
    topics             = ["microservice", "billing", "api", "azure-container-apps"]
    prod_approvers = [
      {
        email    = "seniorguy@gmail.com"
        username = "seniorguy"
      }
    ]
    environments = {
      "dev" = {
